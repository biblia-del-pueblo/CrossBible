<Project DefaultTargets="Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">

    <!-- Builds the Linux packages of CrossBible: for every architecture a Debian (.deb) and a Fedora (.rpm) package, and a .tar.gz, each with
         the native AOT build of CrossBible.Desktop (no .NET runtime is needed to run them).

             dotnet msbuild LinuxPackages.proj -p:FileVersion=<version>

         Native AOT does not build for another operating system: run it on Linux (WSL on Windows). It needs the tools of the target PublishRuntime below,
         "dotnet tool install -g CrossPlatformPackager" (wpkg) and rpmbuild (the rpm package) for the Fedora packages.
         -t:PublishDesktopAot publishes only the .tar.gz of every runtime, with the musl ones (Alpine) too. -->

    <PropertyGroup>
        <netlatest>net11.0</netlatest>
        <Version Condition=" '$(Version)' == '' ">1.0.2</Version>
        <FileVersion Condition=" '$(FileVersion)' == '' ">$(Version)</FileVersion>
        <VersionLabel Condition=" '$(VersionLabel)' == '' ">$(Version)</VersionLabel>
        <BUILD_NUMBER>$(Version)</BUILD_NUMBER>
        <ReleaseDate Condition=" '$(ReleaseDate)' == '' ">2026-11-17</ReleaseDate>
        <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>

        <PackagesFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</PackagesFolder>
        <RootFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RootFolder>
        <DesktopProject>$(RootFolder)CrossBible.Desktop/CrossBible.Desktop.csproj</DesktopProject>
        <AotPublishFolder>$(RootFolder)publish</AotPublishFolder>
        <StagingFolder>$(PackagesFolder)staging</StagingFolder>
        <BinFolder>$(PackagesFolder)bin</BinFolder>


        <GZipCmd Condition=" '$(OS)' == 'Windows_NT' ">"$(PackagesFolder)tools/gzip/bin/gzip.exe"</GZipCmd>
        <GZipCmd Condition=" '$(OS)' != 'Windows_NT' ">gzip</GZipCmd>
        <WpkgCmd Condition=" '$(OS)' == 'Windows_NT' ">wpkg.exe</WpkgCmd>
        <WpkgCmd Condition=" '$(OS)' != 'Windows_NT' ">wpkg</WpkgCmd>
        <PwshCmd Condition=" '$(OS)' == 'Windows_NT' ">powershell</PwshCmd>
        <PwshCmd Condition=" '$(OS)' != 'Windows_NT' ">pwsh</PwshCmd>
    </PropertyGroup>

    <!-- The architectures of the Debian and Fedora packages. Identity: the .NET runtime (linux-arm is 32 bit ARM, there is no "arm32"); DebArch and RpmArch: the
         name of the architecture for dpkg and for rpm. The musl runtimes (Alpine) have no .deb or .rpm: they are only published as .tar.gz. -->
    <ItemGroup>
        <PackageArch Include="linux-x64">
            <DebArch>amd64</DebArch>
            <RpmArch>x86_64</RpmArch>
            <PacmanArch>x86_64</PacmanArch>
        </PackageArch>
        <PackageArch Include="linux-arm64">
            <DebArch>arm64</DebArch>
            <RpmArch>aarch64</RpmArch>
            <PacmanArch>aarch64</PacmanArch>
        </PackageArch>
        <PackageArch Include="linux-arm">
            <DebArch>armhf</DebArch>
            <RpmArch>armv7hl</RpmArch>
            <PacmanArch>armv7h</PacmanArch>
        </PackageArch>
    </ItemGroup>

    <!-- Alpine uses musl, not glibc: its packages are made from the musl runtimes, with the architecture names of apk (see PackageAlpine). -->
    <ItemGroup>
        <AlpineArch Include="linux-musl-x64">
            <ApkArch>x86_64</ApkArch>
        </AlpineArch>
        <AlpineArch Include="linux-musl-arm64">
            <ApkArch>aarch64</ApkArch>
        </AlpineArch>
        <AlpineArch Include="linux-musl-arm">
            <ApkArch>armv7</ApkArch>
        </AlpineArch>
    </ItemGroup>

    <Target Name="BuildWpkg">
        <!-- Installs the tool, or updates it when it is installed already (install fails then and would leave an old version). -->
        <Exec Command="dotnet tool update -g CrossPlatformPackager" IgnoreExitCode="true" />
    </Target>

    <Target Name="CleanOutput">
        <ItemGroup>
            <OutputPackageFiles Include="$(BinFolder)/*.deb;$(BinFolder)/*.rpm;$(BinFolder)/*.pkg.tar.zst;$(BinFolder)/*.tar.gz" />
        </ItemGroup>
        <Delete Files="@(OutputPackageFiles)" />
        <RemoveDir Directories="$(StagingFolder)" />
    </Target>

    <Target Name="Dos2Unix">
        <ItemGroup>
            <TextFiles Include="$(PackagesFolder)src/bin/crossbible" />
            <TextFiles Include="$(PackagesFolder)src/doc/*.*" />
            <TextFiles Include="$(PackagesFolder)src/desktop/*.*" />
            <TextFiles Include="$(PackagesFolder)Debian/DEBIAN/*.*" />
            <TextFiles Include="$(PackagesFolder)Fedora/SPECS/*.*" />
        </ItemGroup>

        <Exec Command="$(WpkgCmd) -d2u &quot;@(TextFiles)&quot;" LogStandardErrorAsError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="OutputOfDos2Unix" />
        </Exec>
        <Message Text="$(OutputOfDos2Unix)" />
    </Target>

    <!-- Publishes CrossBible.Desktop with native AOT for the runtime AotRuntimeId and packs it as publish/crossbible-<version>-<runtime>.tar.gz.
         It needs clang and zlib1g-dev (the zlib development package); for the ARM runtimes the cross compiler of the machine too (on a x64 machine, for
         linux-arm64: gcc-aarch64-linux-gnu, binutils-aarch64-linux-gnu and the arm64 libraries; for linux-arm the arm ones), and for the musl runtimes a musl
         toolchain (an Alpine machine or container builds them best). -->
    <Target Name="PublishRuntime">
        <PropertyGroup>
            <RuntimeFolder>$(AotPublishFolder)/$(AotRuntimeId)</RuntimeFolder>
            <RuntimeTarball>$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz</RuntimeTarball>
        </PropertyGroup>

        <!-- Building for ARM on a x64 machine: ILCompiler strips the debug symbols with objcopy, which has to be the one of the target (the linker is found by clang
             by its name with the target: gcc-aarch64-linux-gnu and binutils-aarch64-linux-gnu, or gcc-arm-linux-gnueabihf and binutils-arm-linux-gnueabihf). -->
        <PropertyGroup Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64' ">
            <CrossOption Condition=" '$(AotRuntimeId)' == 'linux-arm64' ">-p:ObjCopyName=aarch64-linux-gnu-objcopy</CrossOption>
            <CrossOption Condition=" '$(AotRuntimeId)' == 'linux-arm' ">-p:ObjCopyName=arm-linux-gnueabihf-objcopy</CrossOption>
            <!-- Musl for ARM on a x64 Alpine: linked with lld against the C library of the target, in a root file system of Alpine for that architecture
                 (src/scripts/MakeAlpineSysroot.sh, made by make.sh). -->
            <CrossOption Condition=" '$(AotRuntimeId)' == 'linux-musl-arm64' ">-p:SysRoot=/opt/sysroot/aarch64 -p:LinkerFlavor=lld -p:ObjCopyName=llvm-objcopy</CrossOption>
            <CrossOption Condition=" '$(AotRuntimeId)' == 'linux-musl-arm' ">-p:SysRoot=/opt/sysroot/armv7 -p:LinkerFlavor=lld -p:ObjCopyName=llvm-objcopy</CrossOption>
        </PropertyGroup>

        <!-- UseAot is the switch of CrossBible.Desktop.csproj for PublishAot (with ReadyToRun off).
             Restore, Rebuild and Publish are one msbuild call. Rebuild: the XAML of Avalonia is compiled into the assembly after the C# compiler has run, and a build
             that is incremental on top of the obj folder of an earlier one (of Visual Studio on Windows, say) can leave it out: the app then stops at start with
             "No precompiled XAML found". One call: Visual Studio restores the projects in the background when it is open, and overwrites project.assets.json
             with the NuGet folders of Windows (the build then stops with "Unable to find fallback package folder"): close it while the packages are built. -->
        <!-- -p:SkipPublish=true uses the build in the publish folder, that is already there (of a musl runtime, that was built on an Alpine machine, say). -->
        <PropertyGroup>
            <PublishCommand>dotnet msbuild &quot;$(DesktopProject)&quot; -restore -t:Rebuild -t:Publish -p:Configuration=$(Configuration) -p:RuntimeIdentifier=$(AotRuntimeId) -p:SelfContained=true $(CrossOption) -p:UseAot=true -p:Version=$(Version) -p:PublishDir=&quot;$(RuntimeFolder)/&quot;</PublishCommand>
        </PropertyGroup>
        <Exec Condition=" '$(SkipPublish)' != 'true' " Command="$(PublishCommand)" />

        <!-- A publish can end without error and without its files (it did for linux-arm, while Visual Studio was open and restoring the projects): it is done once more,
             and the build stops when there is still no program, as a package without it (the .tar.gz was 105 bytes) is worse than none. -->
        <Message Condition=" '$(SkipPublish)' != 'true' And !Exists('$(RuntimeFolder)/CrossBible.Desktop') " Importance="high" Text="No CrossBible.Desktop in $(RuntimeFolder) after the publish: it is done once more." />
        <Exec Condition=" '$(SkipPublish)' != 'true' And !Exists('$(RuntimeFolder)/CrossBible.Desktop') " Command="$(PublishCommand)" />
        <Error Condition=" !Exists('$(RuntimeFolder)/CrossBible.Desktop') " Text="The AOT publish for $(AotRuntimeId) made no CrossBible.Desktop in $(RuntimeFolder). Close Visual Studio while the packages are built." />

        <!-- The .tar.gz of the runtime: the program (without the debug symbols) in the folder crossbible, and next to it the installer (src/install/install.sh), the desktop
             file, the icon and the documents, as in the generic package (see PackageNoarch). The files are put together in staging, with the permissions they need. -->
        <PropertyGroup>
            <TarName>crossbible-$(Version)-$(AotRuntimeId)</TarName>
            <TarStage>$(StagingFolder)/tar/$(TarName)</TarStage>
        </PropertyGroup>
        <ItemGroup Condition=" '$(SkipPublish)' != 'true' ">
            <TarFiles Include="$(RuntimeFolder)/**/*.*" Exclude="$(RuntimeFolder)/**/*.pdb;$(RuntimeFolder)/**/*.dbg" />
        </ItemGroup>
        <RemoveDir Condition=" '$(SkipPublish)' != 'true' " Directories="$(TarStage)" />
        <Copy Condition=" '$(SkipPublish)' != 'true' " SourceFiles="@(TarFiles)" DestinationFolder="$(TarStage)/crossbible/%(RecursiveDir)" />
        <Copy Condition=" '$(SkipPublish)' != 'true' " SourceFiles="$(PackagesFolder)src/install/install.sh;$(PackagesFolder)src/icon/crossbible.png;$(PackagesFolder)src/desktop/crossbible.desktop;$(PackagesFolder)src/doc/copyright;$(PackagesFolder)src/doc/ChangeLog" DestinationFolder="$(TarStage)" />
        <Copy Condition=" '$(SkipPublish)' != 'true' " SourceFiles="$(PackagesFolder)src/install/README.native" DestinationFiles="$(TarStage)/README" />
        <!-- The files of a Windows drive have no execute permission: they are set here (the program and the installer are the ones that run). -->
        <Exec Condition=" '$(SkipPublish)' != 'true' " Command="find &quot;$(TarStage)&quot; -type d -exec chmod 755 {} + &amp;&amp; find &quot;$(TarStage)&quot; -type f -exec chmod 644 {} + &amp;&amp; chmod 755 &quot;$(TarStage)/install.sh&quot; &quot;$(TarStage)/crossbible/CrossBible.Desktop&quot;" />
        <Exec Condition=" '$(SkipPublish)' != 'true' " Command="tar --owner=0 --group=0 --numeric-owner -czf &quot;$(RuntimeTarball)&quot; -C &quot;$(StagingFolder)/tar&quot; &quot;$(TarName)&quot;" />
        <Message Condition=" '$(SkipPublish)' != 'true' " Importance="high" Text="Packed $(RuntimeTarball)" />
    </Target>

    <Target Name="PublishDesktopAot">
        <ItemGroup>
            <AotRuntime Include="@(PackageArch)" />
            <AotRuntime Include="linux-musl-x64" />
            <AotRuntime Include="linux-musl-arm64" />
            <AotRuntime Include="linux-musl-arm" />
        </ItemGroup>
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="PublishRuntime" Properties="AotRuntimeId=%(AotRuntime.Identity)" />
    </Target>

    <!-- Makes the .deb and the .rpm of one architecture (AotRuntimeId, DebArch and RpmArch are set by PackageLinux) from the AOT build of PublishRuntime.
         The files of each package are put together in a folder of their own in staging, as the Debian and Fedora folders are the templates for all of them. -->
    <Target Name="PackageRuntime" DependsOnTargets="PublishRuntime">
        <PropertyGroup>
            <DebStage>$(StagingFolder)/deb-$(DebArch)</DebStage>
            <RpmStage>$(StagingFolder)/rpm-$(RpmArch)</RpmStage>
        </PropertyGroup>
        <ItemGroup>
            <AotFiles Include="$(AotPublishFolder)/$(AotRuntimeId)/**/*.*" Exclude="$(AotPublishFolder)/$(AotRuntimeId)/**/*.pdb;$(AotPublishFolder)/$(AotRuntimeId)/**/*.dbg" />
            <DebTemplate Include="$(PackagesFolder)Debian/DEBIAN/**/*.*" />
            <RpmTemplate Include="$(PackagesFolder)Fedora/SPECS/**/*.*" />
            <DocFilesDebian Include="$(PackagesFolder)src/doc/*.*" Exclude="$(PackagesFolder)src/doc/ChangeLog" />
            <DocFilesFedora Include="$(PackagesFolder)src/doc/*.*" Exclude="$(PackagesFolder)src/doc/changelog.Debian" />
        </ItemGroup>

        <RemoveDir Directories="$(DebStage);$(RpmStage)" />

        <!-- Debian -->
        <Copy SourceFiles="@(DebTemplate)" DestinationFolder="$(DebStage)/DEBIAN/%(RecursiveDir)" />
        <Copy SourceFiles="@(AotFiles)" DestinationFolder="$(DebStage)/usr/share/crossbible/%(RecursiveDir)" />
        <Copy SourceFiles="$(PackagesFolder)src/bin/crossbible" DestinationFiles="$(DebStage)/usr/bin/crossbible" />
        <Copy SourceFiles="$(PackagesFolder)src/icon/crossbible.png" DestinationFiles="$(DebStage)/usr/share/pixmaps/crossbible.png" />
        <Copy SourceFiles="$(PackagesFolder)src/desktop/crossbible.desktop" DestinationFolder="$(DebStage)/usr/share/applications" />
        <Copy SourceFiles="@(DocFilesDebian)" DestinationFolder="$(DebStage)/usr/share/doc/crossbible" />
        <Exec Command="$(GZipCmd) -9 -n -f &quot;$(DebStage)/usr/share/doc/crossbible/changelog.Debian&quot;" LogStandardErrorAsError="true" />
        <Exec Command="$(PwshCmd) -NonInteractive -ExecutionPolicy Unrestricted -File &quot;$(PackagesFolder)src/scripts/ConfigureDebian.ps1&quot; &quot;$(FileVersion)&quot; &quot;$(DebStage)&quot; &quot;$(DebArch)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="$(WpkgCmd) -b &quot;$(DebStage)&quot;" LogStandardErrorAsError="true" />
        <ItemGroup>
            <DebBuilt Include="$(DebStage)/*.deb" />
        </ItemGroup>
        <Move SourceFiles="@(DebBuilt)" DestinationFiles="$(BinFolder)/crossbible_$(FileVersion)-1_$(DebArch).deb" />

        <!-- Fedora -->
        <Copy SourceFiles="@(RpmTemplate)" DestinationFolder="$(RpmStage)/SPECS/%(RecursiveDir)" />
        <Copy SourceFiles="@(AotFiles)" DestinationFolder="$(RpmStage)/usr/share/crossbible/%(RecursiveDir)" />
        <Copy SourceFiles="$(PackagesFolder)src/bin/crossbible" DestinationFiles="$(RpmStage)/usr/bin/crossbible" />
        <Copy SourceFiles="$(PackagesFolder)src/icon/crossbible.png" DestinationFiles="$(RpmStage)/usr/share/pixmaps/crossbible.png" />
        <Copy SourceFiles="$(PackagesFolder)src/desktop/crossbible.desktop" DestinationFolder="$(RpmStage)/usr/share/applications" />
        <Copy SourceFiles="@(DocFilesFedora)" DestinationFolder="$(RpmStage)/usr/share/doc/crossbible" />
        <Exec Command="$(PwshCmd) -NonInteractive -ExecutionPolicy Unrestricted -File &quot;$(PackagesFolder)src/scripts/ConfigureFedora.ps1&quot; &quot;$(FileVersion)&quot; &quot;$(RpmStage)&quot; &quot;$(RpmArch)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="$(WpkgCmd) -rd &quot;$(RpmStage)&quot;" LogStandardErrorAsError="true" />
        <ItemGroup>
            <RpmBuilt Include="$(RpmStage)/*.rpm" />
        </ItemGroup>
        <Move SourceFiles="@(RpmBuilt)" DestinationFolder="$(BinFolder)" />

        <!-- Arch Linux (pacman), from the same glibc build. -->
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="StageRoot" Properties="AotRuntimeId=$(AotRuntimeId);StageDir=$(StagingFolder)/pacman-$(PacmanArch)" />
        <Exec Command="sh &quot;$(PackagesFolder)src/scripts/MakeArchPackage.sh&quot; &quot;$(StagingFolder)/pacman-$(PacmanArch)&quot; &quot;$(FileVersion)-1&quot; &quot;$(PacmanArch)&quot; &quot;$(BinFolder)/crossbible-$(FileVersion)-1-$(PacmanArch).pkg.tar.zst&quot;" />

        <!-- The .tar.gz of the same build. -->
        <Copy Condition="Exists('$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz')" SourceFiles="$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz" DestinationFolder="$(BinFolder)" />
    </Target>

    <!-- Puts together the usr tree of a package of the runtime AotRuntimeId in the folder StageDir: the files of Debian and Fedora are put together in
         PackageRuntime, the ones of Arch Linux and Alpine use this. -->
    <Target Name="StageRoot">
        <ItemGroup>
            <RootAotFiles Include="$(AotPublishFolder)/$(AotRuntimeId)/**/*.*" Exclude="$(AotPublishFolder)/$(AotRuntimeId)/**/*.pdb;$(AotPublishFolder)/$(AotRuntimeId)/**/*.dbg" />
            <RootDocFiles Include="$(PackagesFolder)src/doc/*.*" Exclude="$(PackagesFolder)src/doc/changelog.Debian" />
        </ItemGroup>
        <RemoveDir Directories="$(StageDir)" />
        <Copy SourceFiles="@(RootAotFiles)" DestinationFolder="$(StageDir)/usr/share/crossbible/%(RecursiveDir)" />
        <Copy SourceFiles="$(PackagesFolder)src/bin/crossbible" DestinationFiles="$(StageDir)/usr/bin/crossbible" />
        <Copy SourceFiles="$(PackagesFolder)src/icon/crossbible.png" DestinationFiles="$(StageDir)/usr/share/pixmaps/crossbible.png" />
        <Copy SourceFiles="$(PackagesFolder)src/desktop/crossbible.desktop" DestinationFolder="$(StageDir)/usr/share/applications" />
        <Copy SourceFiles="@(RootDocFiles)" DestinationFolder="$(StageDir)/usr/share/doc/crossbible" />
    </Target>

    <Target Name="PackageLinux" DependsOnTargets="BuildWpkg;Dos2Unix;CleanOutput">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="PackageRuntime"
                 Properties="AotRuntimeId=%(PackageArch.Identity);DebArch=%(PackageArch.DebArch);RpmArch=%(PackageArch.RpmArch);PacmanArch=%(PackageArch.PacmanArch)" />
    </Target>

    <!-- The apk packages of Alpine Linux, from the musl runtimes. Not part of Build: native AOT for musl needs a musl toolchain (see PublishRuntime), that is
         best on an Alpine machine or container. Two ways: run -t:PackageAlpine there (it needs GNU tar: apk add tar), or publish the musl runtimes
         there (-t:PublishDesktopAot, then copy the publish folder) and make the packages anywhere with -t:PackageAlpine -p:SkipPublish=true. -->
    <Target Name="PackageAlpineRuntime" DependsOnTargets="PublishRuntime">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="StageRoot" Properties="AotRuntimeId=$(AotRuntimeId);StageDir=$(StagingFolder)/apk-$(ApkArch)" />
        <Exec Command="sh &quot;$(PackagesFolder)src/scripts/MakeAlpinePackage.sh&quot; &quot;$(StagingFolder)/apk-$(ApkArch)&quot; &quot;$(FileVersion)-r0&quot; &quot;$(ApkArch)&quot; &quot;$(BinFolder)/crossbible-$(FileVersion)-r0-linux-$(ApkArch).apk&quot;" />
        <Copy Condition="Exists('$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz')" SourceFiles="$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz" DestinationFolder="$(BinFolder)" />
    </Target>

    <!-- All three architectures are built (ARM from a x64 machine with the sysroots of make.sh, see PublishRuntime). -p:AlpineAllArchs=false builds only the one of
         the machine; with -p:SkipPublish=true all of them are made from the builds in the publish folder that other machines made. -->
    <Target Name="PackageAlpine">
        <PropertyGroup>
            <AlpineHostRuntime Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64' ">linux-musl-x64</AlpineHostRuntime>
            <AlpineHostRuntime Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64' ">linux-musl-arm64</AlpineHostRuntime>
            <AlpineHostRuntime Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm' ">linux-musl-arm</AlpineHostRuntime>
        </PropertyGroup>
        <ItemGroup>
            <AlpineBuild Include="@(AlpineArch)" Condition=" '$(AlpineAllArchs)' != 'false' Or '%(Identity)' == '$(AlpineHostRuntime)' " />
        </ItemGroup>
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="PackageAlpineRuntime"
                 Properties="AotRuntimeId=%(AlpineBuild.Identity);ApkArch=%(AlpineBuild.ApkArch)" />
    </Target>

    <!-- The generic package (crossbible-<version>-noarch.tar.gz): for every Linux and every processor that has the .NET runtime 11. CrossBible.Desktop is published
         without AOT, framework dependent and without the apphost (a program of the processor of this machine): the .dll runs on the runtime of the target, with the
         native libraries (SkiaSharp, HarfBuzz) of all the Linux runtimes next to it (.NET takes the one of the machine). The package has an installer
         (src/noarch/install.sh: into /usr/local, ~/.local or a folder, and it removes it again), the desktop file, the icon and the documents. -->
    <Target Name="PackageNoarch">
        <PropertyGroup>
            <NoarchName>crossbible-$(FileVersion)-noarch</NoarchName>
            <NoarchPublish>$(AotPublishFolder)/noarch</NoarchPublish>
            <NoarchStage>$(StagingFolder)/noarch/$(NoarchName)</NoarchStage>
        </PropertyGroup>

        <RemoveDir Directories="$(NoarchPublish)" />
        <Exec Command="dotnet msbuild &quot;$(DesktopProject)&quot; -restore -t:Rebuild -t:Publish -p:Configuration=$(Configuration) -p:SelfContained=false -p:UseAppHost=false -p:UseAot=false -p:Version=$(Version) -p:PublishDir=&quot;$(NoarchPublish)/&quot;" />
        <Error Condition=" !Exists('$(NoarchPublish)/CrossBible.Desktop.dll') " Text="The publish for the generic package made no CrossBible.Desktop.dll in $(NoarchPublish). Close Visual Studio while the packages are built." />

        <ItemGroup>
            <NoarchExclude Include="$(NoarchPublish)/**/*.pdb;$(NoarchPublish)/**/*.xml" />
            <!-- The native libraries of the systems that are not Linux (the runtimes of Windows, macOS, Android, iOS and the browser) are of no use here. -->
            <NoarchExclude Include="$(NoarchPublish)/runtimes/win*/**;$(NoarchPublish)/runtimes/osx*/**;$(NoarchPublish)/runtimes/maccatalyst*/**;$(NoarchPublish)/runtimes/android*/**;$(NoarchPublish)/runtimes/linux-bionic*/**;$(NoarchPublish)/runtimes/ios*/**;$(NoarchPublish)/runtimes/tvos*/**;$(NoarchPublish)/runtimes/browser*/**" />
            <NoarchFiles Include="$(NoarchPublish)/**/*.*" Exclude="@(NoarchExclude)" />
            <NoarchDocs Include="$(PackagesFolder)src/doc/README;$(PackagesFolder)src/doc/copyright;$(PackagesFolder)src/doc/ChangeLog" />
        </ItemGroup>

        <RemoveDir Directories="$(StagingFolder)/noarch" />
        <Copy SourceFiles="@(NoarchFiles)" DestinationFolder="$(NoarchStage)/crossbible/%(RecursiveDir)" />
        <Copy SourceFiles="$(PackagesFolder)src/install/install.sh;$(PackagesFolder)src/icon/crossbible.png;$(PackagesFolder)src/desktop/crossbible.desktop" DestinationFolder="$(NoarchStage)" />
        <Copy SourceFiles="$(PackagesFolder)src/install/README.noarch" DestinationFiles="$(NoarchStage)/README" />
        <Copy SourceFiles="$(PackagesFolder)src/doc/copyright;$(PackagesFolder)src/doc/ChangeLog" DestinationFolder="$(NoarchStage)" />

        <Delete Files="$(BinFolder)/$(NoarchName).tar.gz" />
        <MakeDir Directories="$(BinFolder)" />
        <!-- The files of a Windows drive have no execute permission: they are set here. -->
        <Exec Command="find &quot;$(NoarchStage)&quot; -type d -exec chmod 755 {} + &amp;&amp; find &quot;$(NoarchStage)&quot; -type f -exec chmod 644 {} + &amp;&amp; chmod 755 &quot;$(NoarchStage)/install.sh&quot;" />
        <Exec Command="tar --owner=0 --group=0 --numeric-owner -czf &quot;$(BinFolder)/$(NoarchName).tar.gz&quot; -C &quot;$(StagingFolder)/noarch&quot; &quot;$(NoarchName)&quot;" />
        <Message Importance="high" Text="Made $(BinFolder)/$(NoarchName).tar.gz" />
    </Target>

    <Target Name="Build" DependsOnTargets="PackageLinux;PackageNoarch" />
</Project>
