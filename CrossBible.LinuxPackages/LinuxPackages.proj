<Project DefaultTargets="Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">

    <!-- Builds the Linux packages of CrossBible: for every architecture a Debian (.deb) and a Fedora (.rpm) package, and a .tar.gz, each with
         the native AOT build of CrossBible.Desktop (no .NET runtime is needed to run them).

             dotnet msbuild LinuxPackages.proj -p:FileVersion=<version>

         Native AOT does not build for another operating system: run it on Linux (WSL on Windows). It needs the tools of the target PublishRuntime below,
         "dotnet tool install -g CrossPlatformPackager" (wpkg) and rpmbuild (the rpm package) for the Fedora packages.
         -t:PublishDesktopAot publishes only the .tar.gz of every runtime, with the musl ones (Alpine) too. -->

    <PropertyGroup>
        <netlatest>net11.0</netlatest>
        <BUILD_NUMBER Condition=" '$(BUILD_NUMBER)' == '' ">1.0.0</BUILD_NUMBER>
        <Version Condition=" '$(Version)' == '' ">1.0.0</Version>
        <FileVersion Condition=" '$(FileVersion)' == '' ">$(BUILD_NUMBER)</FileVersion>
        <VersionLabel Condition=" '$(VersionLabel)' == '' ">$(BUILD_NUMBER)</VersionLabel>
        <ReleaseDate Condition=" '$(ReleaseDate)' == '' ">2026-11-17</ReleaseDate>
        <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>

        <PackagesFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</PackagesFolder>
        <RootFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RootFolder>
        <DesktopProject>$(RootFolder)CrossBible.Desktop/CrossBible.Desktop.csproj</DesktopProject>
        <AotPublishFolder>$(RootFolder)publish</AotPublishFolder>
        <StagingFolder>$(PackagesFolder)staging</StagingFolder>
        <BinFolder>$(PackagesFolder)bin</BinFolder>

        <GZipCmd Condition=" '$(OS)' == 'Windows_NT' ">"$(PackagesFolder)tools/gzip/bin/gzip.exe"</GZipCmd>
        <GZipCmd Condition=" '$(OS)' != 'Windows_NT' ">gzip</GZipCmd>
        <WpkgCmd Condition=" '$(OS)' == 'Windows_NT' ">wpkg.exe</WpkgCmd>
        <WpkgCmd Condition=" '$(OS)' != 'Windows_NT' ">wpkg</WpkgCmd>
        <PwshCmd Condition=" '$(OS)' == 'Windows_NT' ">powershell</PwshCmd>
        <PwshCmd Condition=" '$(OS)' != 'Windows_NT' ">pwsh</PwshCmd>
    </PropertyGroup>

    <!-- The architectures of the Debian and Fedora packages. Identity: the .NET runtime (linux-arm is 32 bit ARM, there is no "arm32"); DebArch and RpmArch: the
         name of the architecture for dpkg and for rpm. The musl runtimes (Alpine) have no .deb or .rpm: they are only published as .tar.gz. -->
    <ItemGroup>
        <PackageArch Include="linux-x64">
            <DebArch>amd64</DebArch>
            <RpmArch>x86_64</RpmArch>
        </PackageArch>
        <PackageArch Include="linux-arm64">
            <DebArch>arm64</DebArch>
            <RpmArch>aarch64</RpmArch>
        </PackageArch>
        <PackageArch Include="linux-arm">
            <DebArch>armhf</DebArch>
            <RpmArch>armv7hl</RpmArch>
        </PackageArch>
    </ItemGroup>

    <Target Name="BuildWpkg">
        <!-- Installs the tool, or updates it when it is installed already (install fails then and would leave an old version). -->
        <Exec Command="dotnet tool update -g CrossPlatformPackager" IgnoreExitCode="true" />
    </Target>

    <Target Name="CleanOutput">
        <ItemGroup>
            <OutputPackageFiles Include="$(BinFolder)/*.deb;$(BinFolder)/*.rpm;$(BinFolder)/*.tar.gz" />
        </ItemGroup>
        <Delete Files="@(OutputPackageFiles)" />
        <RemoveDir Directories="$(StagingFolder)" />
    </Target>

    <Target Name="Dos2Unix">
        <ItemGroup>
            <TextFiles Include="$(PackagesFolder)src/bin/crossbible" />
            <TextFiles Include="$(PackagesFolder)src/doc/*.*" />
            <TextFiles Include="$(PackagesFolder)src/desktop/*.*" />
            <TextFiles Include="$(PackagesFolder)Debian/DEBIAN/*.*" />
            <TextFiles Include="$(PackagesFolder)Fedora/SPECS/*.*" />
        </ItemGroup>

        <Exec Command="$(WpkgCmd) -d2u &quot;@(TextFiles)&quot;" LogStandardErrorAsError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="OutputOfDos2Unix" />
        </Exec>
        <Message Text="$(OutputOfDos2Unix)" />
    </Target>

    <!-- Publishes CrossBible.Desktop with native AOT for the runtime AotRuntimeId and packs it as publish/crossbible-<version>-<runtime>.tar.gz.
         It needs clang and zlib1g-dev (the zlib development package); for the ARM runtimes the cross compiler of the machine too (on a x64 machine, for
         linux-arm64: gcc-aarch64-linux-gnu, binutils-aarch64-linux-gnu and the arm64 libraries; for linux-arm the arm ones), and for the musl runtimes a musl
         toolchain (an Alpine machine or container builds them best). -->
    <Target Name="PublishRuntime">
        <PropertyGroup>
            <RuntimeFolder>$(AotPublishFolder)/$(AotRuntimeId)</RuntimeFolder>
            <RuntimeTarball>$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz</RuntimeTarball>
        </PropertyGroup>

        <!-- dotnet publish restores the packages of its runtime by itself. UseAot is the switch of CrossBible.Desktop.csproj for PublishAot (with ReadyToRun off).
             The build is made apart, with -no-incremental (publish has no such switch): the XAML of Avalonia is compiled into the assembly after the C# compiler
             has run, and a build that is incremental on top of the obj folder of an earlier one (of Visual Studio on Windows, say) can leave it out: the app
             then stops at start with "No precompiled XAML found". -->
        <Exec Command="dotnet build &quot;$(DesktopProject)&quot; -c $(Configuration) -r $(AotRuntimeId) --self-contained true --no-incremental -p:UseAot=true -p:Version=$(Version)" />
        <Exec Command="dotnet publish &quot;$(DesktopProject)&quot; -c $(Configuration) -r $(AotRuntimeId) --self-contained true --no-build -p:UseAot=true -p:Version=$(Version) -o &quot;$(RuntimeFolder)&quot;" />

        <!-- The debug symbols are not part of the package. -->
        <Exec Command="tar -czf &quot;$(RuntimeTarball)&quot; --exclude=&quot;*.pdb&quot; --exclude=&quot;*.dbg&quot; -C &quot;$(RuntimeFolder)&quot; ." />
        <Message Importance="high" Text="Packed $(RuntimeTarball)" />
    </Target>

    <Target Name="PublishDesktopAot">
        <ItemGroup>
            <AotRuntime Include="@(PackageArch)" />
            <AotRuntime Include="linux-musl-x64" />
            <AotRuntime Include="linux-musl-arm64" />
            <AotRuntime Include="linux-musl-arm" />
        </ItemGroup>
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="PublishRuntime" Properties="AotRuntimeId=%(AotRuntime.Identity)" />
    </Target>

    <!-- Makes the .deb and the .rpm of one architecture (AotRuntimeId, DebArch and RpmArch are set by PackageLinux) from the AOT build of PublishRuntime.
         The files of each package are put together in a folder of their own in staging, as the Debian and Fedora folders are the templates for all of them. -->
    <Target Name="PackageRuntime" DependsOnTargets="PublishRuntime">
        <PropertyGroup>
            <DebStage>$(StagingFolder)/deb-$(DebArch)</DebStage>
            <RpmStage>$(StagingFolder)/rpm-$(RpmArch)</RpmStage>
        </PropertyGroup>
        <ItemGroup>
            <AotFiles Include="$(AotPublishFolder)/$(AotRuntimeId)/**/*.*" Exclude="$(AotPublishFolder)/$(AotRuntimeId)/**/*.pdb;$(AotPublishFolder)/$(AotRuntimeId)/**/*.dbg" />
            <DebTemplate Include="$(PackagesFolder)Debian/DEBIAN/**/*.*" />
            <RpmTemplate Include="$(PackagesFolder)Fedora/SPECS/**/*.*" />
            <DocFilesDebian Include="$(PackagesFolder)src/doc/*.*" Exclude="$(PackagesFolder)src/doc/ChangeLog" />
            <DocFilesFedora Include="$(PackagesFolder)src/doc/*.*" Exclude="$(PackagesFolder)src/doc/changelog.Debian" />
        </ItemGroup>

        <RemoveDir Directories="$(DebStage);$(RpmStage)" />

        <!-- Debian -->
        <Copy SourceFiles="@(DebTemplate)" DestinationFolder="$(DebStage)/DEBIAN/%(RecursiveDir)" />
        <Copy SourceFiles="@(AotFiles)" DestinationFolder="$(DebStage)/usr/share/crossbible/%(RecursiveDir)" />
        <Copy SourceFiles="$(PackagesFolder)src/bin/crossbible" DestinationFiles="$(DebStage)/usr/bin/crossbible" />
        <Copy SourceFiles="$(PackagesFolder)src/icon/crossbible.png" DestinationFiles="$(DebStage)/usr/share/pixmaps/crossbible.png" />
        <Copy SourceFiles="$(PackagesFolder)src/desktop/crossbible.desktop" DestinationFolder="$(DebStage)/usr/share/applications" />
        <Copy SourceFiles="@(DocFilesDebian)" DestinationFolder="$(DebStage)/usr/share/doc/crossbible" />
        <Exec Command="$(GZipCmd) -9 -n -f &quot;$(DebStage)/usr/share/doc/crossbible/changelog.Debian&quot;" LogStandardErrorAsError="true" />
        <Exec Command="$(PwshCmd) -NonInteractive -ExecutionPolicy Unrestricted -File &quot;$(PackagesFolder)src/scripts/ConfigureDebian.ps1&quot; &quot;$(FileVersion)&quot; &quot;$(DebStage)&quot; &quot;$(DebArch)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="$(WpkgCmd) -b &quot;$(DebStage)&quot;" LogStandardErrorAsError="true" />
        <ItemGroup>
            <DebBuilt Include="$(DebStage)/*.deb" />
        </ItemGroup>
        <Move SourceFiles="@(DebBuilt)" DestinationFiles="$(BinFolder)/crossbible_$(FileVersion)-1_$(DebArch).deb" />

        <!-- Fedora -->
        <Copy SourceFiles="@(RpmTemplate)" DestinationFolder="$(RpmStage)/SPECS/%(RecursiveDir)" />
        <Copy SourceFiles="@(AotFiles)" DestinationFolder="$(RpmStage)/usr/share/crossbible/%(RecursiveDir)" />
        <Copy SourceFiles="$(PackagesFolder)src/bin/crossbible" DestinationFiles="$(RpmStage)/usr/bin/crossbible" />
        <Copy SourceFiles="$(PackagesFolder)src/icon/crossbible.png" DestinationFiles="$(RpmStage)/usr/share/pixmaps/crossbible.png" />
        <Copy SourceFiles="$(PackagesFolder)src/desktop/crossbible.desktop" DestinationFolder="$(RpmStage)/usr/share/applications" />
        <Copy SourceFiles="@(DocFilesFedora)" DestinationFolder="$(RpmStage)/usr/share/doc/crossbible" />
        <Exec Command="$(PwshCmd) -NonInteractive -ExecutionPolicy Unrestricted -File &quot;$(PackagesFolder)src/scripts/ConfigureFedora.ps1&quot; &quot;$(FileVersion)&quot; &quot;$(RpmStage)&quot; &quot;$(RpmArch)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="$(WpkgCmd) -rd &quot;$(RpmStage)&quot;" LogStandardErrorAsError="true" />
        <ItemGroup>
            <RpmBuilt Include="$(RpmStage)/*.rpm" />
        </ItemGroup>
        <Move SourceFiles="@(RpmBuilt)" DestinationFolder="$(BinFolder)" />

        <!-- The .tar.gz of the same build. -->
        <Copy SourceFiles="$(AotPublishFolder)/crossbible-$(Version)-$(AotRuntimeId).tar.gz" DestinationFolder="$(BinFolder)" />
    </Target>

    <Target Name="PackageLinux" DependsOnTargets="BuildWpkg;Dos2Unix;CleanOutput">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="PackageRuntime"
                 Properties="AotRuntimeId=%(PackageArch.Identity);DebArch=%(PackageArch.DebArch);RpmArch=%(PackageArch.RpmArch)" />
    </Target>

    <Target Name="Build" DependsOnTargets="PackageLinux" />
</Project>
