<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
    <AppxPackageName>CrossBible</AppxPackageName>
  </PropertyGroup>
  <!-- This project is built with Visual Studio's MSBuild: the packaging targets are part of Visual Studio. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>aa6c9cf6-60c2-4343-be8f-f92acd48a28d</ProjectGuid>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- The names of the packages are made from the project name (<name>_<version>_<platform>.msix, <name>_<version>_x64_arm64_bundle.msixupload): lowercase. -->
    <ProjectName>crossbible</ProjectName>
    <!-- The package is not signed: the Store signs what it publishes. Signing here with a certificate of our own would also replace the Publisher in the manifest
         by the subject of that certificate (CN=Estrellas de Esperanza), and Partner Center refuses a package whose Publisher is not the one of the product identity
         (CN=057A2C88-...). To sideload a package, sign it with signtool and a certificate whose subject is the Publisher of the manifest. -->
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <EntryPointProjectUniqueName>..\CrossBible.Desktop\CrossBible.Desktop.csproj</EntryPointProjectUniqueName>
    <!-- Publish > Create App Packages: one .msixupload with the x64 and the ARM64 package. -->
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <!-- The app's packages are restored for this project too, against its UAP target framework: harmless. -->
    <NoWarn>$(NoWarn);NU1701;NU1702;NU1605;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <None Include="Estrellas_de_Esperanza.pfx" />
    <Content Include="Images\LockScreenLogo.scale-200.png" />
    <Content Include="Images\SplashScreen.scale-200.png" />
    <Content Include="Images\Square150x150Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Images\Square44x44Logo.targetsize-256.png" />
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\StoreLogo.scale-200.png" />
    <Content Include="Images\Wide310x150Logo.scale-200.png" />
  </ItemGroup>
  <!-- The languages of the package. Partner Center shows the languages that the package has resources for, which is not the list of Resource elements in the
       manifest: the build makes that list again from resources.pri, and there are only the languages that have a resource of their own. The app translates itself
       (CrossBible.Library/Resources), so these files hold one entry each: they only declare the language, one folder for every language of the manifest. -->
  <ItemGroup>
    <PRIResource Include="Strings\**\Resources.resw" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CrossBible.Desktop\CrossBible.Desktop.csproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>
</Project>