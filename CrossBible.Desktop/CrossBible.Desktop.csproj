<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net8.0-windows TFM, one for MacOS with net8.0-macos and one with net8.0 TFM for Linux.-->
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <Version>0.8.0.0</Version>
        <AssemblyVersion>0.8.0.0</AssemblyVersion>
        <FileVersion>0.8.0.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <!-- CrossBible.Msix packages this app for the Microsoft Store for x64 and ARM64. The app is self-contained there:
         the people who get it from the Store do not have the .NET runtime. A normal build (AnyCPU) is not affected. -->
    <PropertyGroup>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)' == 'x64'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
        <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
    </PropertyGroup>
    <!-- Precompiled (ReadyToRun) for the Store packages: the app starts faster, as the code does not have to be compiled when it runs. Native AOT (below) is
         not used for them yet: LiteDB needs reflection. -->
    <PropertyGroup Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <!-- Native AOT: dotnet publish CrossBible.Desktop -c Release -r win-x64 -p:UseAot=true
         The code is compiled to machine code, without the .NET runtime (a smaller start-up and no JIT). JSON is read and written by source generation (see
         JsonContext in BibleMarkdown and in CrossBible.Library); what is left is LiteDB, which needs reflection (the Strong's dictionaries and the search of the
         words): see the warnings IL2104 and IL3053 of the publish. -->
    <PropertyGroup Condition="'$(UseAot)' == 'true'">
        <PublishAot>true</PublishAot>
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Assets\CrossBible-logo.ico" />
        <None Remove="Assets\logo.icns" />
        <None Remove="Assets\logo.ico" />
        <None Remove="Assets\logo.svg" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets\logo.icns" />
      <AvaloniaResource Include="Assets\logo.ico" />
      <AvaloniaResource Include="Assets\logo.svg" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CrossBible.Library\CrossBible.Library.csproj" />
    </ItemGroup>
</Project>
