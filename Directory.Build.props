<Project>
    <!-- CrossBible.Msix builds the desktop app and the projects it uses for x64 and ARM64, self-contained, with a runtime
         identifier; every project needs to have it restored. Other builds (AnyCPU) are not affected. -->
    <PropertyGroup Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- BibleMarkdown is a library here, not the bibmark tool (an Exe, its default): a self-contained app such as the
         Android app cannot reference an Exe (NETSDK1150). -->
    <PropertyGroup>
        <PackAsTool>false</PackAsTool>
    </PropertyGroup>

    <!-- Application version -->
    <PropertyGroup>
        <Version>1.0.1</Version>
        <AssemblyVersion>$(Version).0</AssemblyVersion>
        <FileVersion>$(Version).0</FileVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    </PropertyGroup>
    
    <!-- The settings and the info files are read and written with System.Text.Json by reflection (the types are not known to a source generator: they are of
         several kinds, see BookText). A trimmed app (the Android Release build) has that switched off by default, and every save of the settings would throw. -->
    <PropertyGroup>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>
</Project>
