<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ApplicationId>org.estrellasdeesperanza.CrossBible</ApplicationId>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    </PropertyGroup>

    <!-- Release: the code is compiled to native code ahead of time (Native AOT, which implies trimming) for 64 bit ARM phones, so the first use of
         each method does not wait for the JIT (the first layout of a book took over a second on a Moto G24). LiteDB raises trim/AOT warnings.
         The x64 emulator is left out of a Release build (it only makes the build and the APK larger): build it with
         -p:AndroidAbis=android-x64 to run a Release build there (make.bat builds one APK per ABI this way, and the Play Store bundle with AndroidAbis=all:
         RuntimeIdentifiers itself must not be given on the command line, it would flow into the referenced projects, and a list with ";" does not survive it).
         A Debug build is not compiled ahead of time. -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AndroidAbis Condition="'$(AndroidAbis)' == ''">android-arm64</AndroidAbis>
        <RuntimeIdentifiers>$(AndroidAbis)</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(AndroidAbis)' == 'all'">android-arm64;android-arm;android-x64</RuntimeIdentifiers>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
        <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
        <!-- Lifecycle at one version (see Directory.Packages.props): the ones that Avalonia.Android would bring at 2.10.0.2 are raised to the version of Core 1.19. -->
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Android" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CrossBible.Library\CrossBible.Library.csproj" />
    </ItemGroup>

    <!-- The Bible's text, bundled into the APK as assets (MainActivity copies them to app storage on first run).
         BibleDirectory is the folder with the numbered .md files; src\booknames.xml supplies the abbreviations.
         Override it with -p:BibleDirectory=... ; without the folder the app starts with a "no Bible found" message. -->
    <PropertyGroup>
        <BibleDirectory Condition="'$(BibleDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\BibliaLibrePrivate\Bibles\English.WorldEnglishBibleUS</BibleDirectory>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(BibleDirectory)')">
        <AndroidAsset Include="$(BibleDirectory)\*.md" Link="Bible\%(Filename)%(Extension)" />
        <AndroidAsset Include="$(BibleDirectory)\src\booknames.xml" Link="Bible\booknames.xml" Condition="Exists('$(BibleDirectory)\src\booknames.xml')" />
    </ItemGroup>
    <ItemGroup>
      <AndroidAsset Remove="C:\GitHub\CrossBible\CrossBible.Android\..\..\BibliaLibrePrivate\Bibles\English.WorldEnglishBibleUS\**" />
    </ItemGroup>

</Project>
